# Moolies NFT World Environment Configuration

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=moolies_db

# Admin Dashboard Authentication Secret (default fallback provided for development: "moolies-secret-key-2026")
ADMIN_AUTH_SECRET=moolies-secret-key-2026
ADMIN_PASSWORD=moolies2026!

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blockchain RPC & Contracts (Optional - falls back to testnet/demo configuration)
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_CONTRACT_ADDRESS=0x71C8A1b2F89A4c6c21e0B11eE5E729F4a6C49573
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER=https://etherscan.io
NEXT_PUBLIC_OPENSEA_URL=https://opensea.io/collection/moolies-official
